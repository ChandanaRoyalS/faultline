+"""Faultline as an SREGym agent: a thin driver.
+
+All of the work is in Faultline's own package (`faultline.sregym.driver`, installed by
+`install-faultline.sh`), so this file holds no logic of its own: the adapter is reviewed and
+tested in Faultline's repository, and the agent under test is the real one.
+"""
+
+import sys
+
+from faultline.sregym.driver import main
+
+if __name__ == "__main__":
+    sys.exit(main())
