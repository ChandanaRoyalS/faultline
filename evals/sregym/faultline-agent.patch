+++ b/docker/agents/install-scripts/install-faultline.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+# Faultline's source bundle (faultline.sregym.bundle), served from the host for the run, installed
+# editable under /opt/faultline so the runtime finds its repository data above its own __file__.
+# Stage 0 measured the install of the same dependencies at 60-64 s inside the hardened container.
+set -euo pipefail
+BUNDLE="faultline-src.tar.gz"
+BUNDLE_URL="${FAULTLINE_BUNDLE_URL:-http://host.docker.internal:55480/$BUNDLE}"
+echo "[$(date -Iseconds)] Installing Faultline from $BUNDLE_URL"
+curl -fsS -o "/tmp/$BUNDLE" "$BUNDLE_URL"
+sha256sum "/tmp/$BUNDLE"
+mkdir -p /opt/faultline
+tar -xzf "/tmp/$BUNDLE" -C /opt/faultline
+python3 -m pip install --break-system-packages -q ${SSL_CERT_FILE:+--cert "$SSL_CERT_FILE"} \
+    --extra-index-url https://download.pytorch.org/whl/cpu -e "/opt/faultline[agents,embeddings]"
+echo "[$(date -Iseconds)] Faultline installed: $(python3 -c 'import faultline; print(faultline.__file__)')"
