@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# Faultline's wheel, served from the host for the run, with the two extras the agent needs and
+# CPU-only torch. Stage 0 measured this at 60-64 s inside the hardened, filtered container.
+set -euo pipefail
+WHEEL="faultline-0.0.1-py3-none-any.whl"
+WHEEL_URL="${FAULTLINE_WHEEL_URL:-http://host.docker.internal:55480/$WHEEL}"
+echo "[$(date -Iseconds)] Installing Faultline from $WHEEL_URL"
+curl -fsS -o "/tmp/$WHEEL" "$WHEEL_URL"
+sha256sum "/tmp/$WHEEL"
+python3 -m pip install --break-system-packages -q ${SSL_CERT_FILE:+--cert "$SSL_CERT_FILE"} \
+    --extra-index-url https://download.pytorch.org/whl/cpu "/tmp/$WHEEL[agents,embeddings]"
+echo "[$(date -Iseconds)] Faultline installed: $(python3 -c 'import importlib.metadata as m; print(m.version("faultline"))')"
