# Copy to .env (never committed). Loaded via pydantic-settings from T2.x onward.
ANTHROPIC_API_KEY=
FAULTLINE_POSTGRES_DSN=postgresql://faultline:faultline-dev@localhost:5432/faultline
FAULTLINE_REDIS_URL=redis://localhost:6379/0

# T5.2. The webhook URL is a bearer credential - anyone holding it can post to the channel as
# this integration - so it belongs here and nowhere else in the tree. Both are empty by default,
# and empty is supported: notifications are simply off.
# Leave the webhook unset on the eval profile. A scored run injects a genuine fault on purpose,
# and the orchestrator has no way to tell one from a real one (see faultline/orchestrator/cli.py).
FAULTLINE_NOTIFY_SLACK_WEBHOOK_URL=
# This platform's externally reachable URL, e.g. https://faultline.example.com. Without it a
# notification still sends, with no link into the UI - there is no default that could be right.
FAULTLINE_NOTIFY_PUBLIC_BASE_URL=
