__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
*.egg-info/
.env

# T5.5: the deployment's real secrets - database password, the credential on the incident read
# surface, and the hostname. `.env` above does not cover it: gitignore patterns without a slash
# match at any depth, but `deploy/.env` is spelled out anyway because the consequence of getting
# it wrong is a published password rather than a noisy diff.
deploy/.env
# The snapshot restored into the deployment. Carries the monitored world's telemetry - every log
# line an agent quoted - and is regenerated by `make deploy-snapshot`, never committed.
deploy/snapshot.sql
deploy/snapshot.sql.gz

evals/reports/*
!evals/reports/.gitkeep

# T1.1: the OTel demo is cloned at a pinned tag, not vendored
world/

# T1.4: injector runtime state - what is broken right now, and the compose
# overrides holding it broken. Machine-local by definition.
.faultline/
.DS_Store

# T4.2's calibration ledger is a RECORD, not an artifact - it is committed deliberately.
# Listed here as a negation so nobody adds `evals/*` above and silently stops tracking it.
!evals/calibration/grades.jsonl

# **The measurement drivers' own stdout.** `faultline-replay`, `faultline-reject-loop` and the
# processes an operator backgrounds beside them (`faultline-ingest`, `nohup`) write transcripts
# into the working tree, and the interesting parts of those transcripts are already captured under
# `docs/evidence/` by the drivers themselves. What was left was ten untracked files in every
# `git status` for two days - noise that trains a reader to skim the one line that matters.
#
# Not a blanket `*.out`: a file matching this pattern that somebody *does* want committed should
# have to say so, and the four names here are the ones this repository actually produces.
loop*.out
replay*.out
ingest.out
nohup.out
