{
  "uid": "faultline-shop-health",
  "title": "Faultline \u2014 Shop health",
  "tags": [
    "faultline",
    "t1.2"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 37,
  "version": 0,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "The world at a glance. Every panel below the top row mirrors one alert rule in compose/prometheus/alert-rules.yml, so a firing alert is explicable on this screen: the rule's own expression, with its threshold drawn as a line. T1.2.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services reporting",
      "description": "Services emitting span metrics. frontend-proxy never appears \u2014 it is Envoy, and no traffic is its healthy steady state (see ServiceNoTraffic).",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "count(sum by (service_name) (rate(calls_total[2m])) > 0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / sec",
      "description": "Total call rate across the shop. Driven by the demo's built-in load generator.",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum(rate(calls_total[2m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Services above 5% errors",
      "description": "Count of services over the ServiceHighErrorRate threshold right now. Healthy baseline is zero on every service.",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "count((sum by (service_name) (rate(calls_total{status_code=\"STATUS_CODE_ERROR\"}[2m]))\n/\nsum by (service_name) (rate(calls_total[2m]))) > 0.05) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worst p95",
      "description": "Highest p95 across all services. Healthy baseline is under 50ms; ServiceHighLatency fires above 250ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "max(histogram_quantile(0.95, sum by (service_name, le) (rate(latency_bucket[2m]))))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error ratio by service \u2014 ServiceHighErrorRate fires above 5%",
      "description": "The rule's own expression without its comparison. Threshold line at 0.05. Axis is pinned to [0,1] because a ratio cannot exceed 1; a service with errors and no completed calls in the window divides by zero and would otherwise drag the scale.",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (service_name) (rate(calls_total{status_code=\"STATUS_CODE_ERROR\"}[2m]))\n/\nsum by (service_name) (rate(calls_total[2m]))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 latency by service \u2014 ServiceHighLatency fires above 250ms",
      "description": "The rule's own expression without its comparison. Threshold line at 250ms. Soft axis maximum of 300ms so the threshold line is visible at rest; a real excursion expands the axis rather than clipping against it.",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(latency_bucket[2m])))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMax": 300
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by service \u2014 ServiceNoTraffic fires when a serving service reaches zero",
      "description": "ServiceNoTraffic needs a service that WAS serving and stopped, so read this for a line that falls to the axis rather than one that was never there.",
      "datasource": {
